<Patch>
	<Operation Class="PatchOperationFindMod">
		<success>Always</success>
		<mods>
			<li>Vanilla Helixien Gas Expanded</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[contains(defName, "VHGE_HelixienGenerator")
				or contains(defName, "VHGE_GasOperatedPodLauncher")
				or contains(defName, "VHGE_GasPipeValve")
				or contains(defName, "VHGE_GasPoweredCrematorium")
				or contains(defName, "VHGE_GasPoweredRefinery")
				or contains(defName, "VHGE_GasCooler")]</xpath>
					<value>
						<minifiedDef>MinifiedThing</minifiedDef>
						<thingCategories>
							<li>BuildingsPower</li>
						</thingCategories>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "VHGE_HelixienGenerator"]/statBases</xpath>
					<value>
						<Mass>40</Mass>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "VHGE_GasOperatedPodLauncher"]/statBases</xpath>
					<value>
						<Mass>20</Mass>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "VHGE_GasPipeValve"]/statBases</xpath>
					<value>
						<Mass>6</Mass>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "VHGE_GasPoweredCrematorium"]/statBases</xpath>
					<value>
						<Mass>20</Mass>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "VHGE_GasPoweredRefinery"]/statBases</xpath>
					<value>
						<Mass>20</Mass>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "VHGE_GasCooler"]/statBases</xpath>
					<value>
						<Mass>35</Mass>
					</value>
				</li>
				<li Class="PatchOperationFindMod">
					<success>Always</success>
					<mods>
						<li>Vanilla Furniture Expanded - Power</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAdd">
								<xpath>Defs/ThingDef[defName = "VHGE_IndustrialHelixienGenerator"]</xpath>
								<value>
									<minifiedDef>MinifiedThing</minifiedDef>
									<thingCategories>
										<li>BuildingsPower</li>
									</thingCategories>
								</value>
							</li>
							<li Class="PatchOperationAdd">
								<xpath>Defs/ThingDef[defName = "VHGE_IndustrialHelixienGenerator"]/statBases</xpath>
								<value>
									<Mass>60</Mass>
								</value>
							</li>
						</operations>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
