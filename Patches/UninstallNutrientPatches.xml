<Patch>
<Operation Class="PatchOperationFindMod">
		<success>Always</success>
		<mods>
			<li>Vanilla Helixien Gas Expanded</li>
		</mods>
		<match Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[contains(defName, "VNPE_NutrientPasteVat")
				or contains(defName, "VNPE_NutrientPasteGrinder")
				or contains(defName, "VNPE_NutrientPasteTap")
				or contains(defName, "VNPE_NutrientPasteFeeder")]</xpath>
				<value>
					<minifiedDef>MinifiedThing</minifiedDef>
					<thingCategories><li>BuildingsMisc</li></thingCategories>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "VNPE_NutrientPasteGrinder"]/statBases</xpath>
				<value>
					<Mass>30</Mass>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "VNPE_NutrientPasteTap"]/statBases</xpath>
				<value>
					<Mass>3</Mass>
				</value>
			</li>
		</operations>
		</match>
	</Operation>
</Patch>
