<Patch>
	<Operation Class="PatchOperationFindMod">
		<success>Always</success>
		<mods>
			<li>Slim Recharger</li>
		</mods>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName = "slimcharger"]</xpath>
			<value>
				<minifiedDef>MinifiedThing</minifiedDef>
				<thingCategories>
					<li>BuildingsMisc</li>
				</thingCategories>
			</value>
		</match>
	</Operation>
</Patch>
